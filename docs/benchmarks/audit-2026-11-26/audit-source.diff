+        return reply->data ? 0 : -1;
+    if (!reply->grow)
+        return -1;
+    size_t next = reply->capacity ? reply->capacity : BUFFER_LENGTH;
+    while (next < needed) {
+        if (next > KVS_RESP_MAX_REPLY / 2) {
+            next = KVS_RESP_MAX_REPLY;
+            break;
+        }
+        next *= 2;
