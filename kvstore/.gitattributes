* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Linux-targeted source and build files use stable LF endings.
*.c text eol=lf
*.h text eol=lf
Makefile text eol=lf
Makefile.* text eol=lf
*.md text eol=lf
*.py text eol=lf
*.js text eol=lf
*.go text eol=lf
*.java text eol=lf
*.rs text eol=lf
*.html text eol=lf
*.cgi text eol=lf

# Vendored archives must never be line-ending normalized.
*.gz binary
