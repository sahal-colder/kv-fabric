* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Linux-targeted source and build files use stable LF endings.
*.c text eol=lf
*.h text eol=lf
Makefile text eol=lf
Makefile.* text eol=lf
CMakeLists.txt text eol=lf
*.cmake text eol=lf
*.cmake.in text eol=lf
*.mk text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.go text eol=lf
*.java text eol=lf
*.rs text eol=lf
*.html text eol=lf
*.cgi text eol=lf

# Vendored archives must never be line-ending normalized.
*.gz binary

# Audit evidence hashes refer to exact captured bytes, including CSV/patch CRLF.
docs/benchmarks/audit-2026-11-26/** -text

# Benchmark evidence hashes refer to original captured bytes.
docs/benchmarks/** -text

*.cu text eol=lf

# Last rule wins: captured source snapshots must retain original CRLF bytes too.
docs/benchmarks/** -text
